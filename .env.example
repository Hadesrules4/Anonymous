# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/unsaid?sslmode=disable

# Optional Individual PG Connection variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=unsaid

# NextAuth / Auth.js Secret
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Resend API Key (Optional in Dev: OTP will log to console if left blank)
RESEND_API_KEY=re_your_resend_api_key_here

# OpenAI API Key (Optional: fallback prompts will be used if left blank)
OPENAI_API_KEY=sk-your_openai_api_key_here
