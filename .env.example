# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/unsaid?retryWrites=true&w=majority

# NextAuth / Auth.js Secret
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Resend API Key (from resend.com for OTP verification emails)
RESEND_API_KEY=re_your_resend_api_key_here

# OpenAI API Key (Optional, for constructive feedback prompt generation)
OPENAI_API_KEY=sk-your_openai_api_key_here
